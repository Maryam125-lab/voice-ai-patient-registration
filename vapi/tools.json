            "emergency_contact_phone": {
              "type": "string",
              "description": "10 digits, digits only"
            }
          },
          "required": [
            "patient_id"
          ]
        }
      },
      "server": {
        "url": "https://YOUR-APP.up.railway.app/vapi/webhook",
        "credentialId": "YOUR_VAPI_CREDENTIAL_ID",
        "timeoutSeconds": 20
      }
    }
  ]
}
