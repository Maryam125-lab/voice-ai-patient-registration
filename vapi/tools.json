              "type": "string",
              "description": "Patient first name"
            },
            "last_name": {
              "type": "string",
              "description": "Patient last name"
            },
            "date_of_birth": {
              "type": "string",
              "description": "MM/DD/YYYY"
            },
            "sex": {
              "type": "string",
              "enum": [
