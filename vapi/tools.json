{
  "_note": "Paste each object into Vapi as a Function tool (or create it in the dashboard). Replace the host and credentialId. The saved credential must send VAPI_WEBHOOK_SECRET in X-Vapi-Secret without a Bearer prefix.",
  "tools": [
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "check_existing_patient",
        "description": "Look up an existing patient by phone number. Call as soon as a valid 10-digit phone number is collected.",
        "parameters": {
          "type": "object",
          "properties": {
            "phone_number": {
              "type": "string",
              "description": "10 digits, digits only"
            }
          },
          "required": [
            "phone_number"
          ]
        }
      },
      "server": {
        "url": "https://YOUR-APP.up.railway.app/vapi/webhook",
        "credentialId": "YOUR_VAPI_CREDENTIAL_ID",
        "timeoutSeconds": 20
      }
    },
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "validate_patient",
        "description": "Validate collected patient data WITHOUT saving. Call once all required fields are collected, before the read-back. Returns specific field errors.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "description": "Patient first name"
            },
            "last_name": {
              "type": "string",
              "description": "Patient last name"
            },
            "date_of_birth": {
              "type": "string",
              "description": "MM/DD/YYYY"
            },
            "sex": {
              "type": "string",
              "enum": [
                "Male",
                "Female",
                "Other",
                "Decline to Answer"
              ]
            },
            "phone_number": {
              "type": "string",
              "description": "10 digits, digits only"
            },
            "email": {
              "type": "string",
              "description": "Optional email address"
            },
            "address_line_1": {
              "type": "string",
              "description": "Street address"
            },
            "address_line_2": {
              "type": "string",
              "description": "Apt/Suite/Unit, optional"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "description": "2-letter US state abbreviation, uppercase"
            },
            "zip_code": {
              "type": "string",
              "description": "5 digits or ZIP+4"
            },
            "insurance_provider": {
              "type": "string"
            },
            "insurance_member_id": {
              "type": "string",
              "description": "Alphanumeric member ID"
            },
            "preferred_language": {
              "type": "string",
              "description": "Default English"
            },
            "emergency_contact_name": {
              "type": "string"
            },
            "emergency_contact_phone": {
              "type": "string",
              "description": "10 digits, digits only"
            }
          },
          "required": []
        }
      },
      "server": {
        "url": "https://YOUR-APP.up.railway.app/vapi/webhook",
        "credentialId": "YOUR_VAPI_CREDENTIAL_ID",
        "timeoutSeconds": 20
      }
    },
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "save_patient",
        "description": "Save the new patient record. Call ONLY after the caller explicitly confirmed a complete read-back.",
        "parameters": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "description": "Patient first name"
            },
            "last_name": {
              "type": "string",
              "description": "Patient last name"
            },
            "date_of_birth": {
              "type": "string",
              "description": "MM/DD/YYYY"
            },
            "sex": {
              "type": "string",
              "enum": [
                "Male",
                "Female",
                "Other",
                "Decline to Answer"
              ]
            },
            "phone_number": {
              "type": "string",
              "description": "10 digits, digits only"
            },
            "email": {
              "type": "string",
              "description": "Optional email address"
            },
            "address_line_1": {
              "type": "string",
              "description": "Street address"
            },
            "address_line_2": {
              "type": "string",
              "description": "Apt/Suite/Unit, optional"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "description": "2-letter US state abbreviation, uppercase"
            },
            "zip_code": {
              "type": "string",
              "description": "5 digits or ZIP+4"
            },
            "insurance_provider": {
              "type": "string"
            },
            "insurance_member_id": {
              "type": "string",
              "description": "Alphanumeric member ID"
            },
            "preferred_language": {
              "type": "string",
              "description": "Default English"
            },
            "emergency_contact_name": {
              "type": "string"
            },
            "emergency_contact_phone": {
              "type": "string",
              "description": "10 digits, digits only"
            }
          },
          "required": [
            "first_name",
            "last_name",
            "date_of_birth",
            "sex",
            "phone_number",
            "address_line_1",
            "city",
            "state",
            "zip_code"
          ]
        }
      },
      "server": {
        "url": "https://YOUR-APP.up.railway.app/vapi/webhook",
        "credentialId": "YOUR_VAPI_CREDENTIAL_ID",
        "timeoutSeconds": 20
      }
    },
    {
      "type": "function",
      "async": false,
      "function": {
        "name": "update_patient",
        "description": "Update an existing patient found by check_existing_patient. Send patient_id and ONLY the changed fields. Call only after the caller confirmed the changes.",
        "parameters": {
          "type": "object",
          "properties": {
            "patient_id": {
              "type": "string",
              "description": "UUID returned by check_existing_patient"
            },
