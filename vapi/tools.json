              ]
            },
            "phone_number": {
              "type": "string",
              "description": "10 digits, digits only"
            },
            "email": {
              "type": "string",
              "description": "Optional email address"
            },
            "address_line_1": {
              "type": "string",
              "description": "Street address"
            },
            "address_line_2": {
              "type": "string",
              "description": "Apt/Suite/Unit, optional"
            },
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "description": "2-letter US state abbreviation, uppercase"
            },
            "zip_code": {
              "type": "string",
